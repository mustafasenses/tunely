{
  "name": "tunely",
  "private": true,
  "version": "1.0.0",
  "description": "Tunely — accurate, offline-capable chromatic tuner web app (kalimba-friendly), Turkish and English.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "make-wavs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/make-test-wavs.ts",
    "test:e2e": "playwright test",
    "generate-assets": "node scripts/generate-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
